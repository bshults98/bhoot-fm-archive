# ── Large local-only data ──────────────────────────────────────────────
# 11 GB of audio files — never commit these
audio/

# Transcript sidecars — generated by BhootFM Transcriber, not needed in repo
transcripts/

# Dev database — ingest.py writes this locally; prod DB is archive.prod.db
archive.db
# Play-counts DB — runtime-only, created on first POST /api/play
plays.db
# SQLite WAL temp files — never commit these
*.db-shm
*.db-wal

# Downloader / uploader state
manifest.json
ia_manifest.json

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# ── OS / editors ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
*.bak
*.log
.env

# ── Build artifacts ────────────────────────────────────────────────────
build/
dist/

# NOTE: archive.prod.db is intentionally NOT ignored.
# Koyeb builds the Docker image from this repo, and the Dockerfile
# copies archive.prod.db into the image as archive.db.
# Run `python prepare_production_db.py` before every git push.
