# ── Large local-only data ──────────────────────────────────────────────
# 11 GB of audio files — never commit these
audio/

# Transcript sidecars — generated by BhootFM Transcriber, not needed in repo
transcripts/

# Dev database — ingest.py writes this locally; prod DB is archive.prod.db
archive.db
# Prod database — uploaded to the HF Dataset by scripts/upload_db_to_dataset.py
# at deploy time, then pulled into the Docker image at build. Never committed
# to git (used to be ~190 MB; LFS storage was bloating the Space quota).
archive.prod.db
# Play-counts DB — runtime-only, created on first POST /api/play
plays.db
# SQLite WAL temp files — never commit these
*.db-shm
*.db-wal

# Downloader / uploader state
manifest.json
ia_manifest.json

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# ── OS / editors ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
*.bak
*.log
.env

# ── Build artifacts ────────────────────────────────────────────────────
build/
dist/

# NOTE: archive.prod.db is hosted on the HF Dataset `xer2ten/bhoot-fm-archive-db`
# and pulled into the image at Docker build time. See:
#   - scripts/upload_db_to_dataset.py  (uploads after every prep step)
#   - Dockerfile                       (urlretrieve at build time)
# Repo no longer carries the DB at all.
