# Don't ship the 11 GB of audio, dev venv, transcript sidecars, etc.
audio/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.git/
.gitignore
.env
.idea/
.vscode/
*.tmp
*.bak
*.log

# Source DB and ingestion-only files. archive.prod.db lives on the HF
# Dataset now; the Dockerfile pulls it via urlretrieve, so it must NOT
# ship in the build context (we'd just waste the upload bandwidth and
# the COPY step is gone anyway).
archive.db
archive.prod.db
manifest.json
transcripts/
scripts/

# Dev play-counts DB — runtime-only, never ship dev counts into prod
plays.db
plays.db-wal
plays.db-shm

# Local-only
*.docx
*.json
!static/**/*.json

# Build artifacts
build/
dist/
*.egg-info/

# Docs that don't need to ship
README.md
